# Public base URL of the deployed game (no trailing slash).
# Used by index.html (%VITE_SITE_URL% → canonical, Open Graph, Twitter, JSON-LD) and by
# scripts/brand/generate.mjs (robots.txt + sitemap.xml). After changing it, run:
#   node scripts/brand/generate.mjs --seo-only
# A different URL per environment can go in .env.production / .env.local (Vite precedence).
VITE_SITE_URL=https://yudadwiptr.github.io/monopoliZ
